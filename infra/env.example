# ===========================================
# SLMS Infrastructure Environment Variables
# ===========================================
# Copy this file to .env and adjust values as needed
# Command: cp env.example .env

# ===========================================
# PostgreSQL Configuration
# ===========================================
POSTGRES_USER=slms
POSTGRES_PASSWORD=slms
POSTGRES_DB=slms
POSTGRES_PORT=5544

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST_PORT=6380

# ===========================================
# Document storage (Synology NFS/SMB or local bind mount)
# ===========================================
# Host path bind-mounted into API container at /app/storage
STORAGE_HOST_PATH=./data/storage
STORAGE_ROOT_PATH=/app/storage

# Legacy CMS/Strapi S3 settings (optional, if CMS is used):
# STORAGE_ENDPOINT=...
# STORAGE_BUCKET=...
# STORAGE_ACCESS_KEY_ID=...
# STORAGE_ACCESS_KEY_SECRET=...

# ===========================================
# Mailhog Configuration (Email testing)
# ===========================================
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025

# ===========================================
# SLMS API & Web (Docker)
# ===========================================
# Ports when running API/Web in Docker
API_PORT=3001
WEB_PORT=3000

# API URL as seen by the browser (for Next.js build and cookie-based auth)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# In production only: restrict registration to @energi-up.com. Set to "true" in prod; leave unset for dev/local.
# NEXT_PUBLIC_REGISTRATION_DOMAIN_RESTRICTION_ENABLED=false

# ===========================================
# Two-server dev (FE and API on different hosts)
# ===========================================
# On the FRONTEND server (e.g. 172.28.92.56) set these so login redirect works:
#   API_URL = public URL for API (browser uses /api/v1; can be same as frontend or API)
#   API_BACKEND_URL = actual API base (required for proxy to reach API and rewrite cookies)
#   NEXT_PUBLIC_APP_URL = public URL of the frontend (e.g. http://172.28.92.56:3000) so post-login redirect does not go to localhost
# Example .env.fe.dev on frontend server:
#   API_URL=http://172.28.92.56:3000
#   API_BACKEND_URL=http://172.28.92.57:3001
#   NEXT_PUBLIC_APP_URL=http://172.28.92.56:3000
#   BUILD_LOW_MEMORY=1
#   NODE_OPTIONS=--max-old-space-size=1024
# On the API server: leave COOKIE_DOMAIN unset when using the frontend proxy (recommended).

# ===========================================
# Production Compose
# ===========================================
# Single-server: docker compose -f infra/docker-compose.prod.yml up -d (use this file for .env)
#
# Two-server prod (FE + BE on different hosts, use IP until domain ready; ports FE:3000, API:3001):
#   Backend:  copy env.example.backend to .env, then docker compose -f infra/docker-compose.prod.backend.yml up -d
#   Frontend: copy env.example.frontend to .env, then docker compose -f infra/docker-compose.prod.frontend.yml up -d
#
# Two-server dev:
#   Backend:  ./infra/up-dev-backend.sh up -d --build api
#   Frontend: ./infra/up-dev-frontend.sh up -d --build web
# Use build --no-cache only when troubleshooting stale cache.
#
# Required for single-server prod (no defaults; set in infra/.env):
DB_USER=slms
DB_PASSWORD=your-db-password
DB_NAME=slms
# External ApsaraDB (optional). If unset, API uses local Docker Postgres.
# See docs/MIGRATE-TO-APSARA-DB.md
# DB_HOST=pgm-xxxx.pgsql.<region>.rds.aliyuncs.com
# DB_PORT=5432
# DATABASE_URL="postgresql://slms:urlencoded-password@pgm-xxxx.pgsql.<region>.rds.aliyuncs.com:5432/slms?schema=public&sslmode=require"
REDIS_PASSWORD=your-redis-password
API_URL=https://your-web-domain.com/api/v1
CORS_ORIGIN=https://your-web-domain.com
JWT_SECRET=your-jwt-secret-replace-in-production
JWT_REFRESH_SECRET=your-refresh-secret-replace-in-production
JWT_ADMIN_SECRET=your-admin-jwt-secret-replace-in-production
STORAGE_HOST_PATH=./data/storage
STORAGE_ROOT_PATH=/app/storage

# Optional
CMS_URL=
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=8h
CORS_ORIGINS=
WEB_URL=
API_PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
REGISTRATION_DOMAIN_RESTRICTION_ENABLED=true

# DWS Hub OIDC (public client, PKCE — no client_secret). Leave empty to disable.
# OIDC_DISCOVERY_URL=https://hub.example.com/api/sso/.well-known/openid-configuration
# OIDC_CLIENT_ID=sustainability-portal
# OIDC_REDIRECT_URI=https://sustainability.kpndomain.com/api/v1/auth/oidc/callback
# OIDC_SCOPES=openid email profile
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=true   # Set to false if the site is served over plain HTTP (e.g. staging without TLS).
                               # Browsers silently reject Secure cookies on HTTP origins.
