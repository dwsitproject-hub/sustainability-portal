# ===========================================
# Production BACKEND server – environment variables
# ===========================================
# Copy to infra/.env on the BACKEND server:
#   cp env.example.backend .env
# Then edit .env with real values and run:
#   docker compose -f infra/docker-compose.prod.backend.yml up -d
#
# Ports: DB host 5000, API host 8001. Allow the frontend server IP to reach this host on 8001.

# -------------------------------------------
# Database (required)
# -------------------------------------------
# Default: local Docker Postgres (service hostname "postgres").
# After ApsaraDB cutover, set a full DATABASE_URL (quoted, password URL-encoded)
# and use `docker compose ... up -d redis api` so local Postgres is not started.
# See docs/MIGRATE-TO-APSARA-DB.md
DB_USER=slms
DB_PASSWORD=your-db-password
DB_NAME=slms
POSTGRES_PORT=5000
# Host port mapping for the local Docker Postgres container only.
# ApsaraDB connection uses DB_HOST / DB_PORT / DATABASE_URL below.

# Uncomment for ApsaraDB RDS PostgreSQL 18 (internal VPC endpoint):
# DB_HOST=pgm-xxxx.pgsql.<region>.rds.aliyuncs.com
# DB_PORT=5432
# DATABASE_URL="postgresql://slms:urlencoded-password@pgm-xxxx.pgsql.<region>.rds.aliyuncs.com:5432/slms?schema=public&sslmode=require"

# -------------------------------------------
# Redis (required)
# -------------------------------------------
REDIS_PASSWORD=your-redis-password

# -------------------------------------------
# JWT – use strong secrets in production (e.g. openssl rand -base64 64)
# -------------------------------------------
JWT_SECRET=your-jwt-secret-replace-in-production
JWT_REFRESH_SECRET=your-refresh-secret-replace-in-production
JWT_ADMIN_SECRET=your-admin-jwt-secret-replace-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=8h

# -------------------------------------------
# CORS – frontend origin so the API accepts browser requests
# Use frontend server IP until domain is ready (e.g. http://192.168.1.10:8000)
# -------------------------------------------
CORS_ORIGIN=http://YOUR_FRONTEND_SERVER_IP:8000
# Optional: comma-separated list if you have multiple origins
# CORS_ORIGINS=http://192.168.1.10:8000,https://app.example.com

# -------------------------------------------
# Document storage – Synology NFS/SMB mount (required for production)
# -------------------------------------------
STORAGE_HOST_PATH=/mnt/nas/slms-docs
STORAGE_ROOT_PATH=/app/storage

# Folder layout on Synology (created automatically on upload):
#   Procedure/Holding Company/
#   Procedure/Operational Unit/{operational-unit-slug}/
#   Sustainability/Policy| Sustainability Report| Regulation| Standards| Grievance/
#   Certificate/Operational Unit/{operational-unit-slug}/
#   License/Operational Unit/{operational-unit-slug}/
#   Updates/

# -------------------------------------------
# Optional
# -------------------------------------------
# SMTP (emails)
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# Public URL for document/download links (e.g. when frontend proxies API)
# API_PUBLIC_BASE_URL=http://YOUR_FRONTEND_SERVER_IP:8000/api/v1
# WEB_URL=http://YOUR_FRONTEND_SERVER_IP:8000
# REGISTRATION_DOMAIN_RESTRICTION_ENABLED=true

# DWS Hub OIDC (public client, PKCE — there is no client_secret)
# OIDC_DISCOVERY_URL=https://hub.example.com/api/sso/.well-known/openid-configuration
# OIDC_CLIENT_ID=sustainability-portal
# OIDC_REDIRECT_URI=https://sustainability.kpndomain.com/api/v1/auth/oidc/callback
# OIDC_SCOPES=openid email profile
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=true   # Set to false if the site is served over plain HTTP (e.g. staging without TLS).
                               # Browsers silently reject Secure cookies on HTTP origins.
